# Copy to backend/.env and fill in. Never commit real values.

# Required
DATABASE_URL=postgresql+psycopg://zerno:CHANGE_ME@localhost:5432/zerno
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Demo behaviour
DEMO_MODE=true
# No email service exists yet. true returns the reset link in the API response.
# Local development only: leave false anywhere reachable by other people.
EXPOSE_RESET_TOKENS=false

# URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Absolute base for image links. Empty means same origin, through the frontend proxy.
PUBLIC_API_URL=

# Storage: local or s3
STORAGE_BACKEND=local
MAX_UPLOAD_MB=10
# S3_BUCKET=
# S3_ENDPOINT_URL=

# Crop photo analysis: demo or yolo (yolo needs requirements-ai.txt and trained weights)
VISION_MODEL=demo
# YOLO_WEIGHTS_PATH=

# Assistant: leave empty to use the labelled demo assistant
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Drone simulator
SIM_MISSION_SECONDS=40
SIM_TICK_SECONDS=0.5
